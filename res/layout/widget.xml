<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:singleLine="true"
            android:text="NOW PLAYING"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Ready for Spotify"
            android:textColor="#FFF2EEE8"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@null"
        android:contentDescription="Previous"
        android:scaleType="centerInside"
        android:src="@drawable/ic_prev" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/play_disc"
        android:contentDescription="Play or pause"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@null"
        android:contentDescription="Next"
        android:scaleType="centerInside"
        android:src="@drawable/ic_next" />
</LinearLayout>
